# Copy to backend/.env for local development. Never commit real secrets.

# PostgreSQL connection (required)
DATABASE_URL=postgres://pos:pos_dev_password@127.0.0.1:5432/pos_dev

# HTTP
BIND_ADDR=0.0.0.0:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false          # set to true behind HTTPS

# Sessions and login protection
SESSION_TTL_HOURS=12
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECS=900

# Product identification
PROVIDER_TIMEOUT_MS=4000
LOOKUP_CACHE_HIT_HOURS=168
LOOKUP_CACHE_MISS_MINUTES=60
# Open Food Facts: required to enable the barcode provider. Use your own contact address.
# See docs/integrations/open-food-facts.md. Never commit a real address.
OFF_USER_AGENT=POS-BPOM-QR/0.1 (contact@example.com)
# OFF_API_BASE_URL=https://world.openfoodfacts.org

# Leave unset until a legitimate, documented BPOM RI endpoint is approved.
# BPOM_API_BASE_URL=

# Operations
DB_MAX_CONNECTIONS=10
LOG_JSON=false
RUST_LOG=info,sqlx=warn
