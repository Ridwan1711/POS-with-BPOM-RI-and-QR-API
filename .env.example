# Copy to .env (git-ignored). Used by docker-compose.yml.

POSTGRES_DB=pos
POSTGRES_USER=pos
# Required. Choose a long random value.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_PORT=5432

# Public URL of the frontend. Must match what users type in the browser.
PUBLIC_APP_ORIGIN=http://localhost:3000
APP_PORT=3000
API_PORT=8080

# Set to true when served over HTTPS (secure cookie flag).
COOKIE_SECURE=false
SESSION_TTL_HOURS=12

# Leave empty until an approved BPOM RI endpoint exists (see docs/integrations/bpom.md).
BPOM_API_BASE_URL=

# Demo data only (see the seed profile in docker-compose.yml). Never use demo credentials in production.
SEED_PASSWORD=ChangeMe123!
